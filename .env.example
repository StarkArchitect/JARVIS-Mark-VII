# ==============================================================================
# J.A.R.V.I.S. Mark VII — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and insert your free API keys.
# See FREE_API_GUIDE.md for step-by-step instructions on getting 100% free keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary AI Intelligence (Choose one or multiple for automatic fallback)
# ------------------------------------------------------------------------------

# Google Gemini (Free Tier: 1,500 req/day — https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Groq Cloud (Ultra-Fast 500+ tok/s — https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
STT_MODEL=whisper-large-v3-turbo

# OpenRouter (Free Open-Source Models — https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Mistral AI (Free Experimentation — https://console.mistral.ai/)
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# Zhipu AI / Z.ai (Free GLM Models — https://open.bigmodel.cn/)
ZHIPUAI_API_KEY=your_zhipu_api_key_here
ZHIPUAI_MODEL=glm-4-flash

# Ollama (100% Local Offline AI — https://ollama.com/)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:latest

# ------------------------------------------------------------------------------
# 2. Voice Subsystems
# ------------------------------------------------------------------------------
# TTS Voice: Microsoft Edge Natural Neural Voice (British Butler)
TTS_VOICE=en-GB-RyanNeural
TTS_RATE=180

# Speech-to-Text: Groq Whisper API (used automatically when GROQ_API_KEY is set)
WAKE_WORD=jarvis

# ------------------------------------------------------------------------------
# 3. User & Assistant Persona
# ------------------------------------------------------------------------------
ASSISTANT_NAME=JARVIS
USER_TITLE=Sir
CONFIRM_SHELL=false
HISTORY_TURNS=16
MAX_TOOL_ITERS=4
